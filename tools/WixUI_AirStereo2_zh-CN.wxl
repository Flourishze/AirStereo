  <String Id="VerifyReadyDlgInstallText" Overridable="no" Value="[UPGRADE_NOTICE]单击“安装”开始安装。单击“上一步”查看或更改任何安装设置。单击“取消”退出向导。" />
  <String Id="msierrSecureObjectsFailedCreateSD" Overridable="yes" Value="无法创建目录权限安全描述符。错误：[2]" />
